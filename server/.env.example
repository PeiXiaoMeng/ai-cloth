# Database (SQLite by default, no extra installation needed)
DATABASE_URL="file:./dev.db"

# Server port
PORT=3000

# JWT secret
JWT_SECRET="change-me-to-a-random-string"

# WeChat Mini-Program credentials (for wx.login code-to-openid exchange)
WX_APPID="your-wx-appid"
WX_SECRET="your-wx-secret"
# Dev mode: skip WeChat API with a fake openid when true. MUST be false in production
WX_MOCK="true"

# DashScope API key for AI virtual try-on
DASHSCOPE_API_KEY="your-dashscope-api-key"
# DashScope virtual try-on model
DASHSCOPE_TRYON_MODEL="qwen-image-2.0"
# Try-on debug mode: return placeholder image when true
DASHSCOPE_MOCK="false"

# Upload / static assets directory
UPLOAD_DIR="./public/uploads"

# Redis connection for the BullMQ task queue (required for async try-on)
REDIS_URL="redis://localhost:6379"
# Max number of AI try-on jobs running at the same time (protects the DashScope rate limit)
TRYON_CONCURRENCY="3"

# Public base URL for images (tunnel / production domain). Falls back to request host if empty
PUBLIC_BASE_URL=""

# Simulated AI latency (ms) in mock mode, so the async queue behavior is observable
DASHSCOPE_MOCK_DELAY="5000"

# Elasticsearch for item search (derived read model; the API keeps serving when it's down)
ELASTICSEARCH_URL="http://localhost:9200"
