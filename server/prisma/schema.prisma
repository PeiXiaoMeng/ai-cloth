generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Clothing item
model ClothingItem {
  id        Int      @id @default(autoincrement())
  title     String // e.g. "Light Blue Graphic T-Shirt"
  image     String // item image path (/static/uploads/clothes/xxx.jpg)
  badge     String   @default("试穿") // badge label rendered by the mini-program
  category  String   @default("") // category: 上衣 (tops) / 裤子 (bottoms)
  isNew     Boolean  @default(false) // whether it is a new arrival ("New" tab)
  sort      Int      @default(0) // sort order, smaller values come first
  createdAt DateTime @default(now())

  tryOnRecords TryOnRecord[]
}

// Mini-program user
model User {
  id         Int      @id @default(autoincrement())
  openid     String   @unique
  quotaBonus Int      @default(0) // extra try-on quota adjusted by the admin (can be positive or negative)
  createdAt  DateTime @default(now())

  tryOnRecords TryOnRecord[]
}

// Try-on record (each successful try-on consumes one quota unit)
model TryOnRecord {
  id        Int      @id @default(autoincrement())
  userId    Int
  itemId    Int
  status    String   @default("PENDING") // PENDING / PROCESSING / SUCCESS / FAILED
  inputImg  String? // user-uploaded photo
  resultImg String? // try-on result image
  errorMsg  String? // failure reason, set when status = FAILED
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id])
  item ClothingItem @relation(fields: [itemId], references: [id])

  @@index([userId, status])
}

// Outbox event for DB -> Elasticsearch sync (v0.3.0 item search).
// The queue carries only itemId; the worker re-reads the latest row from the DB,
// so repeated or out-of-order jobs always write the freshest state to ES.
model ItemIndexOutbox {
  id        Int      @id @default(autoincrement())
  itemId    Int      // target ClothingItem id
  op        String   // UPSERT | DELETE
  status    String   @default("PENDING") // PENDING | QUEUED | DONE | DEAD
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt]) // poller scans by status=PENDING ordered by createdAt
}

// System settings (key-value), e.g. TRY_ON_LIMIT = 3
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
